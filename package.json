{
  "name": "qr-system-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "node -e \"import('node:fs').then(async fs=>{if(!fs.existsSync('dist/index.html')&&fs.existsSync('node_modules/vite')&&fs.existsSync('vite.config.ts')){const{execSync}=await import('node:child_process');execSync('npm run build',{stdio:'inherit'})}})\"",
    "start": "node server.mjs",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "node scripts/test_qr_flows.js"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.55.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.7.4",
    "@types/papaparse": "^5.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "terser": "^5.51.2",
    "typescript": "^5.6.2",
    "vite": "^6.4.4"
  },
  "overrides": {
    "dompurify": "^3.4.17",
